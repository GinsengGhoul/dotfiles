#
# special settings for special programs
# use swaymsg -t get_tree
#

# thunar
for_window [ title="Rename" ] floating enable
for_window [ title="File Operation Progress"] floating enable
for_window [ title="Confirm to replace files"] floating enable
for_window [ title="installer"] floating enable

# firefox
for_window [app_id="firefox.*"] floating enable, border pixel 1

# Tile only main browser windows on non-icon workspaces
for_window [ app_id="firefox.*" ] mark --add f
for_window [ con_mark="^f$" ] floating disable

# Floating dialog overrides
for_window [ title="^(?:Open|Save|Select|Choose|File Upload|Upload)(?: |$).*" ] floating enable, resize set 1024 768
for_window [ title="^About.*" ] floating enable

# steam
for_window [ class="^Steam$" title="^Friends$" ] floating enable
for_window [ class="^Steam$" title="Steam - News" ] floating enable
for_window [ class="^Steam$" title=".* - Chat" ] floating enable
for_window [ class="^Steam$" title="^Settings$" ] floating enable
for_window [ class="^Steam$" title=".* - event started" ] floating enable
for_window [ class="^Steam$" title=".* CD key" ] floating enable
for_window [ class="^Steam$" title="^Steam - Self Updater$" ] floating enable
for_window [ class="^Steam$" title="^Screenshot Uploader$" ] floating enable
for_window [ class="^Steam$" title="^Steam Guard - Computer Authorization Required$" ] floating enable
for_window [ title="^Steam Keyboard$" ] floating enable
#for_window [ class="^steam_app_.*" ] fullscreen enable

for_window [ title="Zoom Workplace" ] floating enable
for_window [ title="Volume Control" ] floating enable, resize set 800 450
for_window [ title="lstopo" ] floating enable
for_window [ app_id="com.github.hluk.copyq" ] floating enable, resize set 640 360
for_window [ app_id="blueman-manager" ] floating enable, resize set 800 450
for_window [ app_id="virt-manager" ] floating enable, resize set 800 600
for_window [ app_id="qt6ct" ] floating enable
for_window [ app_id="org.gnome.Calculator" ] floating enable
for_window [ app_id="org.gnome.Calendar" ] floating enable
for_window [ class="xdman-Main" ] floating enable
for_window [ app_id="io.github.celluloid_player.Celluloid" ] floating enable
for_window [ app_id="nm-connection-editor" ] floating enable

# games
for_window [ class=".*\.exe$" ] floating enable
for_window [ class="steam_app_244210" ] floating enable
